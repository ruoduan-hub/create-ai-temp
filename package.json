{
  "name": "create-ai-temp",
  "version": "0.1.1",
  "description": "面向 AI 协作与现代前端工程的项目模板生成器",
  "type": "module",
  "bin": {
    "create-ai-temp": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "cli",
    "ai",
    "template",
    "nextjs",
    "layered-architecture"
  ],
  "homepage": "https://github.com/ruoduan-hub/create-ai-temp#readme",
  "bugs": {
    "url": "https://github.com/ruoduan-hub/create-ai-temp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruoduan-hub/create-ai-temp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
